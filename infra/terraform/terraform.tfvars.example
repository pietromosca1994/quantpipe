# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars.
#
# tenancy/user/fingerprint/key_file/region are named to match ~/.oci/config's
# fields 1:1 — if you've already run `oci setup config`, copy those values
# straight across instead of looking them up again.

tenancy           = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
user              = "ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint       = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
key_file          = "~/.oci/oci_api_key.pem"
region            = "us-ashburn-1"
compartment_ocid  = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# One entry per network you connect from (home, travel, etc.).
admin_ips           = ["203.0.113.4/32"]
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Region-specific — look this up yourself, see variables.tf's description.
image_ocid = "ocid1.image.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

repo_url = "https://github.com/<you>/quantpipe.git"
