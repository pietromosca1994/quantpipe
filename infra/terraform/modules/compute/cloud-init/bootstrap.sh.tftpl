#!/usr/bin/env bash
set -euxo pipefail

ISCSI_PORTAL="169.254.2.2:3260"
DOCKER_DATA_ROOT="/var/lib/docker"

# oci-utils would normally auto-discover and log in to the Block Volume's
# iSCSI target, but it's not installed on Canonical's Ubuntu images (only
# Oracle Linux ones ship it) — do it directly with iscsiadm instead, which
# is present. Retried because Terraform may still be creating/attaching the
# volume when this script starts.
TARGET_IQN=""
for i in $(seq 1 60); do
  TARGET_IQN=$(iscsiadm -m discovery -t sendtargets -p "$ISCSI_PORTAL" 2>/dev/null | awk '{print $2}' | head -n1 || true)
  [ -n "$TARGET_IQN" ] && break
  sleep 5
done
[ -n "$TARGET_IQN" ]

iscsiadm -m node -o update -T "$TARGET_IQN" -n node.startup -v automatic
iscsiadm -m node -T "$TARGET_IQN" -p "$ISCSI_PORTAL" -l

DATA_DEVICE="/dev/disk/by-path/ip-$ISCSI_PORTAL-iscsi-$TARGET_IQN-lun-1"
for i in $(seq 1 30); do
  [ -b "$DATA_DEVICE" ] && break
  sleep 5
done

if ! blkid "$DATA_DEVICE" &> /dev/null; then
  mkfs.ext4 "$DATA_DEVICE"
fi

# Relocate Docker's data root onto the Block Volume *before* Docker ever
# starts, so every named volume persists across instance recreation.
mkdir -p "$DOCKER_DATA_ROOT"
grep -q "$DATA_DEVICE" /etc/fstab || echo "$DATA_DEVICE $DOCKER_DATA_ROOT ext4 defaults,nofail 0 2" >> /etc/fstab
mount "$DOCKER_DATA_ROOT"

if ! command -v docker &> /dev/null; then
  curl -fsSL https://get.docker.com | sh
fi
systemctl enable --now docker

REPO_DIR="/opt/quantpipe"
if [ -d "$REPO_DIR/.git" ]; then
  git -C "$REPO_DIR" pull
else
  git clone "${repo_url}" "$REPO_DIR"
fi

cd "$REPO_DIR"
# .env is not managed by Terraform and must be created on the VM by hand
# (see .env.example) before the first `docker compose up` — see CLAUDE.md's
# secrets section for why this stays a manual step in v1.
docker compose up -d
