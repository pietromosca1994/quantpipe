# Copy this file to .env and fill in real values. Never commit .env.

# --- Alpaca Market Data API ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper/live trading base URL is irrelevant for market data; this is the data API host.
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- Postgres / TimescaleDB ---
POSTGRES_USER=quantpipe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quantpipe
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# --- MLflow ---
# Local dev default: filesystem artifact store (see docker-compose.yml).
# In production this points at an Oracle Object Storage bucket via its S3-compatible API.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
